# Example environment variables for TaskFlow
# Database configuration (dummy defaults)
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_password_example
POSTGRES_DB=taskflow
DATABASE_URL=postgresql://taskflow:taskflow_password_example@postgres:5432/taskflow

# Nginx configuration (default: default-http.conf or default-https.conf)
NGINX_CONF=default-http.conf
