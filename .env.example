# TaskFlow Environment Variables Template
# Copy to .env for local development

# PostgreSQL Configuration
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_secure_password
POSTGRES_DB=taskflow
DATABASE_URL=postgresql://taskflow:taskflow_secure_password@postgres:5432/taskflow

# Container Registry Image (Optional override)
APP_IMAGE=ghcr.io/nish1ha-ux/taskflow:latest

# Nginx Configuration Selection (http.conf or https.conf)
NGINX_CONF=http.conf
